{
  "name": "service-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Мини-CRM сервисного центра на Google Sheets + Apps Script",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:syntax": "node tools/check-syntax.mjs",
    "check:formulas": "node tools/check-formulas.mjs",
    "check:menu": "node tools/check-menu.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src",
    "check": "npm run check:syntax && npm run check:formulas && npm run check:menu && npm run lint && npm test",
    "prepare": "node tools/install-hooks.mjs",
    "backup": "node tools/sync.mjs backup",
    "pull": "node tools/sync.mjs pull",
    "push": "clasp push --force",
    "status": "clasp status",
    "open": "clasp open-script"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.0",
    "eslint": "^9.0.0"
  }
}
