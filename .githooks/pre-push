#!/usr/bin/env bash
# Локальный барьер перед отправкой в GitHub: гоняет те же проверки, что и CI.
#
# Зачем он нужен. Защиту ветки GitHub не даёт приватным репозиториям на
# бесплатном тарифе, поэтому запретить push со сломанным кодом на стороне
# сервера нельзя. Этот хук — замена на стороне клиента: проверки те же самые,
# просто выполняются до отправки, а не после.
#
# Чем он НЕ является. Это не защита: хук живёт на конкретной машине и обходится
# флагом `git push --no-verify`. Он ловит забывчивость, а не злой умысел —
# и этого достаточно, потому что забывчивость и есть настоящая причина почти
# всех сломанных сборок.
#
# Установка: npm ci (см. tools/install-hooks.mjs) либо вручную:
#   git config core.hooksPath .githooks

set -u

echo "pre-push: прогоняю проверки (npm run check)…"

if npm run --silent check; then
  echo "pre-push: проверки зелёные, отправляю."
  exit 0
fi

cat >&2 <<'MSG'

pre-push: ОТПРАВКА ОТМЕНЕНА — проверки не прошли.

Почини то, на что ругнулись проверки выше, и повтори push.
Если нужно отправить именно как есть (например, показать поломку коллеге) —
git push --no-verify
MSG
exit 1
